# Sandbox image for running the Hermes Agent (used when SANDBOX_MODE=docker).
# The orchestrator runs:  docker run --rm -i -v <job-dir>:/workspace -w /workspace \
#     [-v <HERMES_HOME>:/root/.hermes:ro] <DOCKER_AGENT_IMAGE> hermes -z --yolo ...
#
# This image must contain the `hermes` executable plus a toolchain rich enough for
# the repos you target (git, node, python, build tools, etc.). Add languages/SDKs
# your repositories need.

FROM python:3.12-slim

# Base toolchain. Extend per your repos' needs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

# Node 20 (many target repos need it; harmless otherwise).
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Install Hermes Agent ──────────────────────────────────────────────────────
# Uses the official install script. Running as root with no TTY triggers the
# non-interactive FHS layout: code → /usr/local/lib/hermes-agent,
# command → /usr/local/bin/hermes.
# --skip-setup  skips the interactive configuration wizard.
# --skip-browser skips Playwright/Chromium (not needed for code agent tasks).
RUN curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh \
    | bash -s -- --skip-setup --skip-browser

# Bake in the default config (model, provider, base_url).
# Rewrite localhost → host.docker.internal so Ollama is reachable from inside
# the container (the orchestrator passes --add-host=host.docker.internal:host-gateway).
# A runtime HERMES_HOME volume mount will overlay this if provided.
COPY .hermes /root/.hermes
RUN sed -i 's|http://localhost:|http://host.docker.internal:|g' /root/.hermes/config.yaml

WORKDIR /workspace
ENTRYPOINT []
