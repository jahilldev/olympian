# Sandbox image for running the Hermes Agent (used when SANDBOX_MODE=docker).
# The orchestrator runs:  docker run --rm -i -v <job-dir>:/workspace -w /workspace \
#     [-v <HERMES_HOME>:/root/.hermes:ro] <DOCKER_AGENT_IMAGE> hermes -z --yolo ...
#
# This image must contain the `hermes` executable plus a toolchain rich enough for
# the repos you target (git, node, python, build tools, etc.). Add languages/SDKs
# your repositories need.

FROM python:3.12-slim

# Base toolchain. Extend per your repos' needs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

# Node 20 (many target repos need it; harmless otherwise).
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Install Hermes Agent ──────────────────────────────────────────────────────
# Uses the official install script. Running as root with no TTY triggers the
# non-interactive FHS layout: code → /usr/local/lib/hermes-agent,
# command → /usr/local/bin/hermes.
# --skip-setup  skips the interactive configuration wizard.
# --skip-browser skips Playwright/Chromium (not needed for code agent tasks).
RUN curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh \
    | bash -s -- --skip-setup --skip-browser

# Install the Langfuse SDK into the Hermes venv so the observability plugin
# can emit OTLP traces (POST /api/public/otel/v1/traces, application/x-protobuf).
# The hermes wrapper unsets PYTHONPATH/PYTHONHOME before exec-ing the venv python,
# so packages must live inside the venv — not in the system site-packages.
RUN /usr/local/lib/hermes-agent/venv/bin/python3 -m ensurepip \
    && /usr/local/lib/hermes-agent/venv/bin/python3 -m pip install --no-cache-dir langfuse

# Bake in the default config (model, provider, base_url).
# Rewrite localhost → host.docker.internal in every *.yaml so Ollama is reachable
# from inside the container (the orchestrator passes --add-host=host.docker.internal:host-gateway).
# All yaml files are rewritten because cli-config.yaml may also contain localhost URLs
# if it was generated by hermes:local before hermes:docker was run.
# A runtime HERMES_HOME volume mount will overlay this if provided.
COPY .hermes /root/.hermes
RUN find /root/.hermes -name '*.yaml' -print0 \
    | xargs -0 sed -i \
        -e 's|http://localhost:|http://host.docker.internal:|g' \
        -e 's|loopback_host_alias: localhost|loopback_host_alias: host.docker.internal|g'

WORKDIR /workspace
ENTRYPOINT []
