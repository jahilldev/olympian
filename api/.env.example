# ── Server ────────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=development
LOG_LEVEL=info

# ── Database (SQLite, file-based — no server to provision) ──────────────────
# Path is relative to the prisma/ directory (so this resolves to api/prisma/dev.db).
DATABASE_URL=file:./dev.db

# ── GitHub App ───────────────────────────────────────────────────────────────
# From the GitHub App settings page.
GITHUB_APP_ID=000000
# The webhook secret you configured on the App.
GITHUB_WEBHOOK_SECRET=replace-me
# The App private key (PEM). Either inline (with literal \n) or a file path via GITHUB_APP_PRIVATE_KEY_PATH.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./github.pem

# ── Browser (optional — Camofox) ────────────────────────────────────────────
# Camofox is a self-hosted Firefox-based stealth browser server.
# When set, all hermes browser tools route through Camofox instead of the
# cloud providers. Leave empty to disable (hermes falls back to agent-browser).
# Start Camofox: git clone https://github.com/jo-inc/camofox-browser && cd camofox-browser && make up
# For SANDBOX_MODE=docker the agent container automatically uses host.docker.internal;
# for SANDBOX_MODE=none set this to http://localhost:9377.
CAMOFOX_URL=

# ── Hermes Agent CLI ─────────────────────────────────────────────────────────
# Tip: `npm run hermes:local` (repo root) fills in HERMES_BIN/HERMES_HOME/SANDBOX_MODE
# with an isolated, project-local HERMES_HOME separate from your global ~/.hermes.
HERMES_BIN=hermes
# HERMES_HOME is the hermes data directory — config, memory notes (MEMORY.md/USER.md),
# skills, and sessions. Defaults to api/.hermes/ which already contains the project's
# config.yaml and SOUL.md. In SANDBOX_MODE=docker, the orchestrator bind-mounts
# MEMORY.md, USER.md, and skills/ from here into each agent container so learning
# persists across invocations.
HERMES_HOME=
# Model/provider overrides (optional). Falls back to Hermes config when unset.
HERMES_PRIMARY_MODEL=
HERMES_PRIMARY_PROVIDER=
# Optional model/provider overrides specifically for review steps. This allows using a more
# capable or independent model to review than the one used for implementation.
#HERMES_REVIEW_MODEL=
#HERMES_REVIEW_PROVIDER=
# Optional model/provider overrides for the testing step. Falls back to HERMES_PRIMARY_MODEL.
# Use a lighter/faster model here to keep test runs cheap.
#HERMES_TESTING_MODEL=
#HERMES_TESTING_PROVIDER=
# Hard wall-clock ceiling (ms) for a single Hermes invocation — the process is killed
# regardless of activity once this elapses. For local inference with large models, increase
# this; a full implementation cycle can take well over an hour on modest hardware.
HERMES_TIMEOUT_MS=21600000

# ── Orchestration policy ─────────────────────────────────────────────────────
# Only issues with this label are picked up.
TRIGGER_LABEL=hermes
# Review confidence (0-100) required before opening a PR.
REVIEW_CONFIDENCE_THRESHOLD=85
MAX_PLAN_REVISIONS=10
MAX_IMPLEMENTATION_ITERATIONS=5
MAX_REVIEW_PASSES=10
# Slash-command prefix used in issue comments (e.g. "/hermes approve").
COMMAND_PREFIX=/hermes

# ── Queue / worker ───────────────────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# How often the worker polls for due tasks (ms).
WORKER_POLL_INTERVAL_MS=2000
QUEUE_MAX_ATTEMPTS=3
# Backoff base (ms); delay = base * 2^(attempt-1).
QUEUE_BACKOFF_BASE_MS=15000
# A task RUNNING longer than this (ms) is considered orphaned and reclaimable.
QUEUE_LOCK_TTL_MS=3600000

# ── Workspace / git ──────────────────────────────────────────────────────────
WORKSPACE_ROOT=./.workspaces
GIT_AUTHOR_NAME=Hermes Agent
GIT_AUTHOR_EMAIL=hermes@users.noreply.github.com
# Branch name template; {issue} is replaced with the issue number.
BRANCH_PREFIX=hermes/issue-

# ── Sandbox ──────────────────────────────────────────────────────────────────
# none = run hermes as a local subprocess; docker = run hermes inside a container.
SANDBOX_MODE=none
DOCKER_AGENT_IMAGE=hermes-agent:latest
# Optional: command the agent should run to verify acceptance criteria (tests/build).
VERIFY_COMMAND=
