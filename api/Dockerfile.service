# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache openssl
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY tsconfig*.json nest-cli.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

# ── Runtime stage ────────────────────────────────────────────────────────────
# node:22-slim (Debian) is required: hermes Python package wheels are compiled
# for glibc and are incompatible with Alpine's musl libc.
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# git + openssh-client: workspace module (clone/commit/push).
# openssl + ca-certificates: Prisma engine + HTTPS git remotes.
# curl + bash: hermes installer (downloads uv, which manages its own Python).
# docker.io: Docker CLI used by SANDBOX_MODE=docker to spawn sibling agent containers
#   via the host Docker socket mounted at /var/run/docker.sock.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates openssl curl bash docker.io \
    && rm -rf /var/lib/apt/lists/*

# Install the Hermes agent CLI (SANDBOX_MODE=none). Running as root on Linux
# the installer uses FHS layout: code at /usr/local/lib/hermes-agent, binary
# at /usr/local/bin/hermes. With SANDBOX_MODE=docker the agent runs in
# DOCKER_AGENT_IMAGE instead and this binary is unused.
RUN curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh \
    | bash -s -- --skip-setup --skip-browser

# Bake in the default config (model, provider, base_url).
# Rewrite localhost → host.docker.internal so Ollama is reachable from inside
# the container. A runtime HERMES_HOME volume mount will overlay this if provided.
COPY .hermes /root/.hermes
RUN sed -i \
    -e 's|http://localhost:|http://host.docker.internal:|g' \
    -e 's|loopback_host_alias: localhost|loopback_host_alias: host.docker.internal|g' \
    /root/.hermes/config.yaml
COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh
EXPOSE 3030
ENTRYPOINT ["./docker-entrypoint.sh"]
