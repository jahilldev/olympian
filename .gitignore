# dependencies (hoisted to the workspace root)
node_modules/

# build output
dist/
*.tsbuildinfo

# test
coverage/

# logs
*.log
logs/

# env & secrets
.env
.env.*
!.env.example
*.pem

# os
.DS_Store

# agent workspaces (cloned repos / worktrees)
.workspaces/

# downloaded issue/comment attachments (per-workspace, not source)
.attachments/

# isolated, project-local Hermes home (config/credentials/sessions/state)
# anchored to root so api/.hermes/ (the packaged default config) can be tracked
/.hermes/

# generated files
api/prisma/dev.db